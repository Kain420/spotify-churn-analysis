from sklearn.ensemble import GradientBoostingClassifier
from sklearn.model_selection import (train_test_split,
                                     RandomizedSearchCV,
                                     GridSearchCV)
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.metrics import (classification_report,
                             precision_score,
                             recall_score)

X = data_encoded.drop(['user_id', 'is_churned'], axis=1)
y = data_encoded['is_churned']

X_train, X_test, y_train, y_test = train_test_split(X, y, random_state=42, test_size=0.3)

pipe = Pipeline([("std", StandardScaler()),
                 ("model", GradientBoostingClassifier())])

param_rand = {"model__n_estimators": [300, 500, 700],
              "model__learning_rate": [0.01, 0.06],
              "model__subsample": [0.1, 0.3, 0.4],
              "model__max_depth": [3, 4, 5],
              "model__random_state": [42]}

clf_rand = RandomizedSearchCV(pipe, param_rand, cv=5, scoring="f1")
clf_rand.fit(X_train, y_train)

print("F1:", clf_rand.best_score_)
print("Parametr:", clf_rand.best_params_)

y_pred = clf_rand.predict(X_test)
print(classification_report(y_test, y_pred))

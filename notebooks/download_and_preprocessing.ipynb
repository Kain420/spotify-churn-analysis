import pandas as pd
import numpy as np

dataset_url = "https://raw.githubusercontent.com/Kain420/spotify-churn-analysis/refs/heads/develop/data/spotify_churn_dataset.csv"
data = pd.read_csv(dataset_url)
  
data_encoded = pd.get_dummies(data,
                              columns=['gender', 'country', 'subscription_type', 'device_type'],
                              drop_first=True)

print("Исходные колонки:", data.shape[1])
print("После кодирования:", data_encoded.shape[1])
print("\nРаспределение классов:\n", data_encoded['is_churned'].value_counts())
